# =========================================================
# KeyGo Supabase Environment Configuration Template
# Plantilla de Configuración de Ambiente para KeyGo Supabase
# =========================================================
#
# INSTRUCTIONS / INSTRUCCIONES:
# 1. Copy this file to create environment-specific files:
#    - .env.local (for local development)
#    - .env.h2 (for local H2 profile)
#    - .env.desa (for development/staging)
#    - .env.prod (for production)
# 2. Fill in the values for each environment
# 3. Use switch-env.sh script to activate an environment
# 4. NEVER commit .env files to git!
#
# 1. Copiar este archivo para crear archivos específicos por ambiente:
#    - .env.local (para desarrollo local)
#    - .env.h2 (para perfil local con H2)
#    - .env.desa (para desarrollo/staging)
#    - .env.prod (para producción)
# 2. Completar los valores para cada ambiente
# 3. Usar el script switch-env.sh para activar un ambiente
# 4. ¡NUNCA commitear archivos .env a git!
# =========================================================

# =========================================================
# ENVIRONMENT IDENTIFICATION
# IDENTIFICACIÓN DEL AMBIENTE
# =========================================================
# Options: local, desa, prod
# Opciones: local, desa, prod
KEYGO_ENV=local

# =========================================================
# SPRING PROFILES
# PERFILES DE SPRING
# =========================================================
# Active Spring profiles (comma-separated)
# Perfiles activos de Spring (separados por coma)
SPRING_PROFILES_ACTIVE=supabase,local

# =========================================================
# SUPABASE DATABASE CONFIGURATION
# CONFIGURACIÓN DE BASE DE DATOS SUPABASE
# =========================================================

# Database JDBC URL for Spring Boot
# URL JDBC para Spring Boot
# Format: jdbc:postgresql://[HOST]:[PORT]/[DATABASE]
SUPABASE_URL=jdbc:postgresql://localhost:5432/keygo

# Database Connection String (for Flyway and psql)
# Cadena de conexión de base de datos (para Flyway y psql)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
SUPABASE_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/keygo

# Database Host
# Host de base de datos
SUPABASE_DB_HOST=localhost

# Database Port
# Puerto de base de datos
SUPABASE_DB_PORT=5432

# Database Name
# Nombre de base de datos
SUPABASE_DB_NAME=keygo

# Database User
# Usuario de base de datos
# ⚠️ POOLER (Supavisor): usar formato postgres.{project_ref} → ej: postgres.abcdefghijklmn
#    Conexión directa (puerto 5432 directo al DB): solo "postgres"
#    Sin el project_ref el pooler responde: FATAL: Tenant or user not found
SUPABASE_USER=postgres

# Database Password
# Contraseña de base de datos
SUPABASE_PASSWORD=postgres

# Database Schema
# Esquema de base de datos
SUPABASE_DB_SCHEMA=public

# =========================================================
# SUPABASE PROJECT CONFIGURATION
# CONFIGURACIÓN DEL PROYECTO SUPABASE
# =========================================================

# Supabase Project Reference ID
# ID de referencia del proyecto Supabase
SUPABASE_PROJECT_ID=your-project-id

# Supabase Project URL (API)
# URL del proyecto Supabase (API)
SUPABASE_API_URL=http://localhost:54321

# Supabase REST API URL
# URL de la API REST de Supabase
SUPABASE_REST_URL=http://localhost:54321/rest/v1

# Supabase GraphQL URL
# URL de GraphQL de Supabase
SUPABASE_GRAPHQL_URL=http://localhost:54321/graphql/v1

# Supabase Realtime URL
# URL de Realtime de Supabase
SUPABASE_REALTIME_URL=ws://localhost:54321/realtime/v1

# Supabase Storage URL
# URL de Storage de Supabase
SUPABASE_STORAGE_URL=http://localhost:54321/storage/v1

# =========================================================
# SUPABASE AUTHENTICATION KEYS
# CLAVES DE AUTENTICACIÓN SUPABASE
# =========================================================

# Supabase Anon Key (public key - safe to expose)
# Clave anónima de Supabase (pública - segura para exponer)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Supabase Service Role Key (secret key - keep secure!)
# Clave de rol de servicio (secreta - mantener segura!)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# JWT Secret (for token validation)
# Secreto JWT (para validación de tokens)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# =========================================================
# FLYWAY CONFIGURATION
# CONFIGURACIÓN DE FLYWAY
# =========================================================

# Flyway schemas to manage
# Esquemas de Flyway a gestionar
FLYWAY_SCHEMAS=public

# Flyway baseline version
# Versión base de Flyway
FLYWAY_BASELINE_VERSION=1

# Flyway baseline on migrate
# Baseline de Flyway al migrar
FLYWAY_BASELINE_ON_MIGRATE=true

# Flyway validate on migrate
# Validar Flyway al migrar
FLYWAY_VALIDATE_ON_MIGRATE=true

# =========================================================
# APPLICATION CONFIGURATION
# CONFIGURACIÓN DE APLICACIÓN
# =========================================================

# Server Port
# Puerto del servidor
SERVER_PORT=8080

# Application Context Path
# Ruta de contexto de la aplicación
SERVER_CONTEXT_PATH=/keygo-server

# Log Level
# Nivel de log
LOG_LEVEL=INFO

# Log Level for KeyGo
# Nivel de log para KeyGo
LOG_LEVEL_KEYGO=DEBUG

# Log Level for Hibernate
# Nivel de log para Hibernate
LOG_LEVEL_HIBERNATE=INFO

# Log Level for Spring
# Nivel de log para Spring
LOG_LEVEL_SPRING=INFO

# =========================================================
# KEYGO APPLICATION KEYS
# CLAVES DE APLICACIÓN KEYGO
# =========================================================

# Admin key for protected API routes (header X-KEYGO-ADMIN)
# Clave de administrador para rutas de API protegidas (header X-KEYGO-ADMIN)
# NEVER use the default value in production / NUNCA usar el valor por defecto en producción
KEYGO_ADMIN_KEY=changeMe

# Base URL used as OAuth2 issuer (iss claim in JWT)
# URL base usada como emisor OAuth2 (claim iss en JWT)
KEYGO_ISSUER_BASE_URL=http://localhost:8080/keygo-server

# Base URL for UI (for links in emails, notifications, etc.)
# URL base de la UI (para enlaces en emails, notificaciones, etc.)
# Local: http://localhost:5173 | Desa: https://desa.yourdomain.com | Prod: https://yourdomain.com
KEYGO_UI_BASE_URL=http://localhost:5173

# =========================================================
# EMAIL / SMTP CONFIGURATION
# CONFIGURACIÓN DE EMAIL / SMTP
# =========================================================

# SMTP server host
# Host del servidor SMTP
# Local dev: use MailHog (localhost:1025) or Mailtrap
# Prod: smtp.sendgrid.net / email-smtp.us-east-1.amazonaws.com / smtp.gmail.com
SMTP_HOST=localhost

# SMTP server port (587=STARTTLS, 465=SSL, 1025=MailHog)
# Puerto del servidor SMTP (587=STARTTLS, 465=SSL, 1025=MailHog)
SMTP_PORT=587

# SMTP authentication username
# Usuario para autenticación SMTP
SMTP_USERNAME=

# SMTP authentication password / app password
# Contraseña / app password para autenticación SMTP
SMTP_PASSWORD=

# Sender email address (From header)
# Dirección de email del remitente (header From)
KEYGO_MAIL_FROM=noreply@keygo.example.com

# Application name shown in email subject and body
# Nombre de la aplicación que aparece en el asunto y cuerpo del email
KEYGO_MAIL_APP_NAME=KeyGo

# =========================================================
# SECURITY CONFIGURATION
# CONFIGURACIÓN DE SEGURIDAD
# =========================================================

# Enable CORS
# Habilitar CORS
CORS_ENABLED=true

# CORS Allowed Origins (comma-separated)
# Orígenes permitidos CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Enable CSRF Protection
# Habilitar protección CSRF
CSRF_ENABLED=false

# =========================================================
# DEVELOPMENT TOOLS
# HERRAMIENTAS DE DESARROLLO
# =========================================================

# Enable H2 Console (only for local)
# Habilitar consola H2 (solo para local)
H2_CONSOLE_ENABLED=false

# Enable Swagger UI
# Habilitar Swagger UI
SWAGGER_ENABLED=true

# Enable Spring Boot Actuator
# Habilitar Spring Boot Actuator
ACTUATOR_ENABLED=true

# Actuator Endpoints to expose (comma-separated)
# Endpoints de Actuator a exponer (separados por coma)
ACTUATOR_ENDPOINTS=health,info,metrics,env,flyway

