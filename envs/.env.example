# =============================================================================
# KeyGo Server — Plantilla de variables de entorno
# =============================================================================
# Copia este archivo al nombre del perfil que necesites y completa los valores:
#
#   envs/.env.local-h2       → perfil: h2,local      (H2 local, sin Docker)
#   envs/.env.local-supabase → perfil: supabase,local (PostgreSQL local vía Docker)
#   envs/.env.desa           → perfil: supabase,desa  (ambiente de desarrollo)
#   envs/.env.prod           → perfil: supabase,prod  (producción)
#
# Activar con switch-env.sh:
#   ./scripts/switch-env.sh local-h2
#   ./scripts/switch-env.sh local-supabase
#
# ⚠️  NUNCA commitear archivos .env.* distintos de .env.example.
# =============================================================================

# =============================================================================
# RUNTIME
# =============================================================================

# Perfiles activos de Spring (separados por coma).
# Determina qué application-<profile>.yml se carga.
#
#   h2,local        → H2 file-based local, bootstrap deshabilitado
#   supabase,local  → PostgreSQL local, bootstrap deshabilitado, sin caché de templates
#   supabase,desa   → PostgreSQL remoto, logs JSON a archivo
#   supabase,prod   → PostgreSQL producción, logs JSON a archivo
SPRING_PROFILES_ACTIVE=h2,local

# Puerto HTTP del servidor.
# Default: 8080
# PORT=8080

# =============================================================================
# SMTP
# Requerido en todos los perfiles. Sin estos valores la app no arranca.
# =============================================================================

# Host del servidor SMTP.
# local   : localhost  (MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# desa    : smtp.mailtrap.io  o  sandbox.smtp.mailtrap.io
# prod    : smtp.sendgrid.net  /  email-smtp.us-east-1.amazonaws.com  /  smtp.gmail.com
SMTP_HOST=localhost

# Puerto SMTP.
# local MailHog : 1025
# STARTTLS      : 587
# SSL           : 465
SMTP_PORT=1025

# Credenciales SMTP (dejar vacías para MailHog local).
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# KEYGO — URLs y configuración de la aplicación
# Los valores mostrados son los defaults definidos en application.yml.
# Solo es necesario declarar una variable si el valor difiere del default.
# =============================================================================

# URL base usada como emisor OAuth2 (claim `iss` en los JWT).
# Default: http://localhost:8080/keygo-server
# prod : https://api.yourdomain.com/keygo-server
# KEYGO_ISSUER_BASE_URL=http://localhost:8080/keygo-server

# URL base de la UI (para enlaces en emails y notificaciones).
# Default: http://localhost:5173
# prod : https://app.yourdomain.com
# KEYGO_UI_BASE_URL=http://localhost:5173

# Orígenes permitidos para CORS (separados por coma).
# Default: http://localhost:5173
# desa : https://desa.yourdomain.com
# prod : https://app.yourdomain.com
# KEYGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# URI de redirección OAuth2 de la plataforma.
# Default: http://localhost:5173/callback
# prod : https://app.yourdomain.com/callback
# KEYGO_PLATFORM_REDIRECT_URI=http://localhost:5173/callback

# Nombre de la aplicación plataforma (aparece en el flujo OAuth2).
# Default: KeyGo Platform
# KEYGO_PLATFORM_APP_NAME=KeyGo Platform

# Dirección remitente de los emails transaccionales.
# Default: noreply@keygo.example.com
# prod : noreply@yourdomain.com
# KEYGO_MAIL_FROM=noreply@keygo.example.com

# Nombre de la aplicación que aparece en el asunto y cuerpo de los emails.
# Default: KeyGo
# KEYGO_MAIL_APP_NAME=KeyGo

# Roles concedidos automáticamente cuando keygo.bootstrap.enabled=false.
# Solo relevante en perfiles local/h2 donde el bootstrap está deshabilitado.
# Default: ADMIN,ADMIN_TENANT,USER,KEYGO_ADMIN,KEYGO_ACCOUNT_ADMIN,KEYGO_USER
# KEYGO_BOOTSTRAP_BYPASS_ROLES=ADMIN,ADMIN_TENANT,USER

# =============================================================================
# SUPABASE — Base de datos
# Solo requerido con el perfil `supabase`. Ignorado en el perfil `h2`.
# =============================================================================

# URL JDBC para Spring Boot / HikariCP.
# local  : jdbc:postgresql://localhost:5432/keygo
# prod   : jdbc:postgresql://db.<project_ref>.supabase.co:5432/postgres
#          o pooler transaction: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=jdbc:postgresql://localhost:5432/keygo

# Usuario de la base de datos.
# Conexión directa (puerto 5432)   : postgres
# Pooler Supavisor (puerto 6543)   : postgres.<project_ref>
#   Sin el project_ref el pooler responde: FATAL Tenant or user not found
SUPABASE_USER=postgres

# Contraseña de la base de datos.
SUPABASE_PASSWORD=postgres

# Esquema de la base de datos.
# Default: public
# SUPABASE_DB_SCHEMA=public

# =============================================================================
# SUPABASE — Pool de conexiones (HikariCP)
# Solo relevante con el perfil `supabase`. Los defaults funcionan bien en local.
# =============================================================================

# Modo del pooler:
#   0 → transaction mode (Supavisor puerto 6543, sin prepared statements)
#   5 → session mode     (conexión directa puerto 5432, prepared statements normales)
# Default: 0
# SUPABASE_PREPARE_THRESHOLD=0

# Tamaño máximo del pool. Default: 10
# prod : ajustar según conexiones disponibles en el plan de Supabase
# DATASOURCE_POOL_SIZE=10

# Mínimo de conexiones idle. Default: 5
# DATASOURCE_MIN_IDLE=5

# Timeout de obtención de conexión (ms). Default: 30000
# DATASOURCE_CONNECTION_TIMEOUT=30000

# Timeout de conexión idle antes de devolverla al pool (ms). Default: 600000
# DATASOURCE_IDLE_TIMEOUT=600000

# Tiempo de vida máximo de una conexión en el pool (ms). Default: 1800000
# DATASOURCE_MAX_LIFETIME=1800000

# =============================================================================
# FLYWAY — Migraciones
# Solo relevante con el perfil `supabase`. Deshabilitado en el perfil `h2`.
# =============================================================================

# Esquemas gestionados por Flyway. Default: public
# FLYWAY_SCHEMAS=public

# Versión base para baseline-on-migrate. Default: 1
# FLYWAY_BASELINE_VERSION=1

# Crear baseline si no existe historial de migraciones. Default: true
# FLYWAY_BASELINE_ON_MIGRATE=true

# Validar checksums al migrar. Default: true
# FLYWAY_VALIDATE_ON_MIGRATE=true

# Deshabilitar flyway:clean (previene borrado accidental de datos). Default: true
# ⚠️  Mantener en true en desa y prod.
# FLYWAY_CLEAN_DISABLED=true

# Permitir migraciones fuera de orden (útil en branches paralelas). Default: false
# FLYWAY_OUT_OF_ORDER=false

# =============================================================================
# HIBERNATE — Debug SQL (solo para desarrollo)
# =============================================================================

# Formatear el SQL en el log. Default: false
# HIBERNATE_FORMAT_SQL=false

# Mostrar el SQL generado en el log. Default: false
# HIBERNATE_SHOW_SQL=false

# =============================================================================
# LOGGING
# Spring Boot acepta LOGGING_LEVEL_<PACKAGE>=<LEVEL> como variables de entorno.
# El logback-spring.xml activa consola colorida en local y JSON a archivo en desa/prod.
# =============================================================================

# Nivel de log del código propio de KeyGo.
# Default del logback-spring.xml: DEBUG en local, INFO en desa/prod.
# LOGGING_LEVEL_IO_CMARTINEZS_KEYGO=DEBUG

# Directorio de los archivos de log (solo perfiles desa/prod).
# Default: logs
# logging.file.path=logs

# =============================================================================
# SCRIPTS CLI (no usados por Spring Boot)
# Para herramientas externas: psql, migrate.sh, flyway CLI, SDK de Supabase.
# =============================================================================

# Cadena de conexión completa para psql y scripts de migración.
# Formato: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# SUPABASE_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/keygo

# Componentes de conexión (para scripts que construyen la URL por partes).
# SUPABASE_DB_HOST=localhost
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=keygo

# Credenciales del proyecto Supabase (para SDK cliente, CLI de Supabase, scripts).
# prod : valores del dashboard en supabase.com → Project Settings → API
# SUPABASE_PROJECT_ID=local-dev
# SUPABASE_API_URL=http://localhost:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_JWT_SECRET=
